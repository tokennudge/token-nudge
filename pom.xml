<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.tokennudge</groupId>
  <artifactId>tokennudge</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>

  <name>TokenNudge — inverted WireMock for Camunda 7 and CIB Seven</name>
  <description>
    Test-support library that reaches into a running Camunda 7 / CIB Seven engine and
    nudges stalled process instances past their wait states (external tasks, messages,
    user tasks) according to declarative, WireMock-style rules.
  </description>
  <url>https://github.com/tokennudge/token-nudge</url>

  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <scm>
    <connection>scm:git:https://github.com/tokennudge/token-nudge.git</connection>
    <developerConnection>scm:git:git@github.com:tokennudge/token-nudge.git</developerConnection>
    <url>https://github.com/tokennudge/token-nudge</url>
    <tag>HEAD</tag>
  </scm>

  <developers>
    <developer>
      <id>nedimjahic</id>
      <name>Nedim Jahic</name>
      <email>me@nedimjahic.com</email>
      <url>https://github.com/nedimjahic</url>
    </developer>
  </developers>

  <modules>
    <module>tokennudge-core</module>
    <module>tokennudge-camunda7</module>
    <module>tokennudge-junit5</module>
    <module>tokennudge-examples</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <maven.compiler.release>25</maven.compiler.release>

    <!-- One repository for the whole multi-module build: modules should inherit this exact
         url/scm, not have their own artifactId path segment appended. -->
    <project.url.inherit.append.path>false</project.url.inherit.append.path>
    <project.scm.url.inherit.append.path>false</project.scm.url.inherit.append.path>
    <project.scm.connection.inherit.append.path>false</project.scm.connection.inherit.append.path>
    <project.scm.developerConnection.inherit.append.path>false</project.scm.developerConnection.inherit.append.path>

    <!-- Test dependency versions -->
    <junit-bom.version>5.14.4</junit-bom.version>
    <assertj-core.version>3.27.7</assertj-core.version>

    <!-- Consumed by tokennudge-camunda7 (Jackson) and its integration tests
         (Testcontainers, SLF4J). -->
    <jackson-bom.version>2.20.2</jackson-bom.version>
    <testcontainers-bom.version>2.0.5</testcontainers-bom.version>
    <slf4j-simple.version>2.0.17</slf4j-simple.version>

    <!-- Plugin versions -->
    <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
    <maven-compiler-plugin.version>3.14.1</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
    <maven-failsafe-plugin.version>3.5.6</maven-failsafe-plugin.version>
    <maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>
    <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
    <maven-javadoc-plugin.version>3.11.2</maven-javadoc-plugin.version>
    <maven-source-plugin.version>3.3.1</maven-source-plugin.version>
    <maven-gpg-plugin.version>3.2.7</maven-gpg-plugin.version>
    <central-publishing-maven-plugin.version>0.7.0</central-publishing-maven-plugin.version>

    <!-- Integration-test target engine; "camunda" (default) or "cibseven". -->
    <tokennudge.it.engine>camunda</tokennudge.it.engine>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit-bom.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj-core.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson-bom.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers-bom.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-simple</artifactId>
        <version>${slf4j-simple.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <!-- Pinned so it wins over the older transitive version testcontainers depends on,
             avoiding an SLF4J 1.x/2.x provider mismatch warning at test time. -->
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j-simple.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>io.github.tokennudge</groupId>
        <artifactId>tokennudge-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.tokennudge</groupId>
        <artifactId>tokennudge-core</artifactId>
        <version>${project.version}</version>
        <classifier>tests</classifier>
        <type>test-jar</type>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${maven-enforcer-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <release>${maven.compiler.release}</release>
            <parameters>true</parameters>
            <failOnWarning>true</failOnWarning>
            <compilerArgs>
              <arg>-Xlint:all</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
          <configuration>
            <includes>
              <include>**/*Test.java</include>
            </includes>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${maven-failsafe-plugin.version}</version>
          <configuration>
            <includes>
              <include>**/*IT.java</include>
            </includes>
            <!-- No <skipITs> here on purpose: hardcoding it (even to false) overrides
                 -DskipITs on the command line, which silently made that flag inert and ran the
                 full container-backed IT suite anyway. Failsafe's own default already runs ITs
                 when the property is unset, so -DskipITs now works as documented. -->
            <systemPropertyVariables>
              <tokennudge.it.engine>${tokennudge.it.engine}</tokennudge.it.engine>
            </systemPropertyVariables>
          </configuration>
          <executions>
            <execution>
              <goals>
                <goal>integration-test</goal>
                <goal>verify</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven-jar-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco-maven-plugin.version}</version>
          <executions>
            <execution>
              <id>prepare-agent</id>
              <goals>
                <goal>prepare-agent</goal>
              </goals>
            </execution>
            <execution>
              <id>prepare-agent-integration</id>
              <goals>
                <goal>prepare-agent-integration</goal>
              </goals>
            </execution>
            <execution>
              <id>report</id>
              <phase>verify</phase>
              <goals>
                <goal>report</goal>
              </goals>
            </execution>
            <execution>
              <id>report-integration</id>
              <phase>verify</phase>
              <goals>
                <goal>report-integration</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-versions</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[25,)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9.6,)</version>
                </requireMavenVersion>
              </rules>
              <fail>true</fail>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!-- Everything Maven Central requires: sources and Javadoc jars (doclint on, so a broken
           public comment fails here rather than at release time), GPG signatures, and the
           Central Portal publisher. Not part of the default `verify`, since generating and
           signing artifacts on every build is unnecessary cost; run explicitly with
           `-Prelease`. Skipped in tokennudge-examples (`maven.javadoc.skip`/`maven.source.skip`
           alongside its `maven.deploy.skip`), which is not part of the published API surface.
           See RELEASING.md for the full release procedure. -->
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>${maven-source-plugin.version}</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>${maven-javadoc-plugin.version}</version>
            <configuration>
              <doclint>all</doclint>
              <quiet>true</quiet>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <!-- Signing and uploading, kept apart from `release` on purpose: `release` must stay
           runnable by anyone (and by CI) without a PGP key, since its job is to catch broken
           Javadoc. This profile is only for an actual release:
           `./mvnw -Prelease,central clean deploy`. See RELEASING.md. -->
      <id>central</id>
      <build>
        <plugins>
          <plugin>
            <!-- Central requires a detached PGP signature for every published artifact. The
                 key never lives in this repository: gpg.keyname and the passphrase come from
                 the developer's environment or ~/.m2/settings.xml. -->
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>${maven-gpg-plugin.version}</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
                <configuration>
                  <!-- Non-interactive: fail rather than block on a passphrase prompt in CI. -->
                  <gpgArguments>
                    <arg>--pinentry-mode</arg>
                    <arg>loopback</arg>
                  </gpgArguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <!-- Uploads to the Sonatype Central Portal on `deploy`. autoPublish is false on
                 purpose: a release lands in the portal as a staged deployment for a human to
                 inspect and release, so a mistaken `deploy` is recoverable. -->
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>${central-publishing-maven-plugin.version}</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>false</autoPublish>
              <waitUntil>validated</waitUntil>
              <!-- The publisher bundles every reactor module and ignores maven.deploy.skip,
                   so the demo app has to be excluded by name. Do NOT use skipPublishing on
                   that module instead: it is the last module in the reactor, and skipping it
                   there cancels the whole upload while still bundling its artifacts. -->
              <excludeArtifacts>
                <excludeArtifact>tokennudge-examples</excludeArtifact>
              </excludeArtifacts>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
