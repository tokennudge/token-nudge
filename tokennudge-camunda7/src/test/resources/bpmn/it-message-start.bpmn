<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             targetNamespace="http://tokennudge.github.io/it">
  <process id="it-message-start" name="IT Message Start" isExecutable="true" camunda:historyTimeToLive="P1D">
    <startEvent id="start">
      <messageEventDefinition messageRef="itStartConfirmed" />
    </startEvent>
    <sequenceFlow id="flow1" sourceRef="start" targetRef="end" />
    <endEvent id="end" />
  </process>
  <message id="itStartConfirmed" name="ItStartConfirmed" />
</definitions>
