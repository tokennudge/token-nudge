<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             targetNamespace="http://tokennudge.github.io/it">
  <process id="it-receive-task" name="IT Receive Task" isExecutable="true" camunda:historyTimeToLive="P1D">
    <startEvent id="start" />
    <sequenceFlow id="flow1" sourceRef="start" targetRef="confirm" />
    <receiveTask id="confirm" name="Wait for confirmation" messageRef="itConfirmedReceive" />
    <sequenceFlow id="flow2" sourceRef="confirm" targetRef="end" />
    <endEvent id="end" />
  </process>
  <message id="itConfirmedReceive" name="ItConfirmed" />
</definitions>
